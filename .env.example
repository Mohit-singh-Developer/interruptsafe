# InterruptSafe - environment variable template.
#
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every key below is read by the BACKEND only; no secret is
# ever sent to the browser.
#
#   cp .env.example .env
#
# The backend loads this file with Node's own process.loadEnvFile(), so no
# dotenv dependency is involved and a missing .env is not an error. Real
# environment variables take precedence over values in this file.
#
# Run `npm run preflight:rime` after editing to confirm the configuration is
# valid and that no credential has leaked into a tracked file.

# ---------------------------------------------------------------------------
# Rime TTS - the primary spoken output. SET THIS FIRST.
# ---------------------------------------------------------------------------
# Rime is the only synthesiser in this project and there is no fallback voice.
# InterruptSafe is about interrupting speech, so the intended path - and the
# one the demo runs on - requires this key.
#
# Leaving it blank is a supported DEGRADED mode, not the normal one: the server
# starts, /api/health reports "speech": { "provider": "none" }, /api/tts answers
# 503, and the UI states that voice output is unavailable. Text chat, mock
# tools, generation fencing and interruption still work, so the correctness core
# can be developed and tested without spending anything - but nothing is spoken,
# so the interruption-of-audio half of the product is not exercised.
#
# Server-side only. It is never sent to the browser and never written to a log.
RIME_API_KEY=

# Rime voice. Defaults to "luna" - an English voice available on BOTH mistv3
# and coda, checked against the live catalogue:
#   https://users.rime.ai/data/voices/all-v2.json
#
# Voice and model must be compatible. "celeste" is a coda voice and is NOT
# available on mistv3; that pairing is rejected at startup.
RIME_SPEAKER=

# Rime model id. Documented values include "mistv3" (lowest latency, 4
# languages) and "coda" (flagship quality, 9 languages). Defaults to "mistv3":
# for an interruption-focused agent, time-to-first-audio beats fidelity.
#
# The endpoint is a constant in the server (https://users.rime.ai/v1/rime-tts,
# Rime's default global host - no regional endpoint is selected) and cannot be
# set from here or from the browser.
RIME_MODEL=

# ---------------------------------------------------------------------------
# Speech-to-text
# ---------------------------------------------------------------------------
# Nothing to configure. Recognition uses the browser's own Web Speech API, so
# there is no speech-to-text credential, account or SDK in this project. No
# third-party STT service is contacted by this application.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Which provider answers a chat request:
#
#   deterministic  - mock replies, no network call, no API key needed (default)
#   anthropic      - real model; requires ANTHROPIC_API_KEY and LLM_MODEL below
#
# Selecting "anthropic" without the required values is a startup error. The
# server never falls back to the mock on its own.
LLM_PROVIDER=deterministic

# Anthropic API key. Obtain from the Anthropic Console.
# Required only when LLM_PROVIDER=anthropic. Never commit a real value.
ANTHROPIC_API_KEY=

# Model id used by the default LLM provider implementation. Kept as an env var
# so the model can be changed without touching the agent loop.
LLM_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max.
# "low" is the recommended default for voice - it reduces time-to-first-token.
LLM_EFFORT=low

# ---------------------------------------------------------------------------
# Development aids  (optional, never required)
# ---------------------------------------------------------------------------
# Artificial latency for the deterministic mock provider, in milliseconds.
#
# The mock replies instantly, which leaves no window in which to press
# Interrupt by hand. Setting this opens one, so stale-result fencing can be
# demonstrated in the browser. Default 0 (inert). It has no effect on the real
# provider and is not part of the correctness model - the fencing check runs
# identically whether or not this is set.
DEV_DETERMINISTIC_DELAY_MS=

# Artificial latency for the MOCK tools, in milliseconds. Default 0.
#
# Mock tools return instantly otherwise, leaving no window in which to press
# Interrupt while one is running. Set this to demonstrate a slow tool being
# superseded mid-run. This is the fixed tool delay the acceptance test uses.
DEV_MOCK_TOOL_DELAY_MS=

# How MOCK tools react to an abort request: cooperative | stubborn
#
#   cooperative (default) - the tool watches the signal and stops early.
#   stubborn              - the tool ignores the signal and returns anyway.
#
# Both produce a correct outcome. "stubborn" is the interesting one for a demo:
# it proves the late result is discarded by generation fencing, not because
# cancellation worked.
DEV_MOCK_TOOL_MODE=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787

# trace | debug | info | warn | error
LOG_LEVEL=info
