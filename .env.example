# InterruptSafe - environment variable template.
#
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every key below is read by the BACKEND only; no secret is
# ever sent to the browser.
#
#   cp .env.example .env
#
# The "Needed from" column tells you which development phase first requires the
# value. Phases 1-7 run with no third-party keys except ANTHROPIC_API_KEY.

# ---------------------------------------------------------------------------
# LLM provider  (needed from Phase 3)
# ---------------------------------------------------------------------------
# Anthropic API key. Obtain from the Anthropic Console.
ANTHROPIC_API_KEY=

# Model id used by the default LLM provider implementation. Kept as an env var
# so the model can be changed without touching the agent loop.
LLM_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max.
# "low" is the recommended default for voice - it reduces time-to-first-token.
LLM_EFFORT=low

# ---------------------------------------------------------------------------
# Rime TTS - PRIMARY and ONLY text-to-speech provider  (needed from Phase 9)
# ---------------------------------------------------------------------------
# Rime API key. Server-side only; never exposed to the frontend.
RIME_API_KEY=

# Rime voice/speaker identifier.
RIME_SPEAKER=

# Rime model id. Exact accepted values are confirmed against Rime's live
# documentation in Phase 9 before the client is written.
RIME_MODEL=

# ---------------------------------------------------------------------------
# Speech-to-text  (needed from Phase 8 - deferred, not used in Phases 1-7)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Server  (needed from Phase 1)
# ---------------------------------------------------------------------------
PORT=8787

# trace | debug | info | warn | error
LOG_LEVEL=info
